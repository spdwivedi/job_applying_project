#!/usr/bin/env bash
set -euo pipefail

# JobApplier-Core pre-commit security & privacy guard.
# Blocks staged protected files, API keys, emails, phone numbers,
# and code/data content references to protected local directories.

API_KEY_REGEX='(^|[^0-9A-Za-z_-])(AIzaSy[0-9A-Za-z_-]{10,}|sk-[0-9A-Za-z_-]{10,})'
EMAIL_REGEX='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
PHONE_REGEX='(^|[^0-9A-Za-z])(\+[1-9][0-9]{0,2}[[:space:].-]?(\([0-9]{2,4}\)|[0-9]{2,5})([[:space:].-]?[0-9]{3,5}){1,3}|\+[1-9][0-9]{9,14}|\([0-9]{3}\)[[:space:]-]?[0-9]{3}[[:space:]-][0-9]{4}|[0-9]{3}[. -][0-9]{3}[. -][0-9]{4})([^0-9.]|$)'
PROTECTED_PATH_REGEX='(^|/)(vault|history|logs)(/|$)'
PROTECTED_CONTENT_REGEX='(^|[^0-9A-Za-z_])(vault|history|logs)/'

blocked=0

report_violation() {
    local reason="$1"
    local file="$2"
    local detail="${3:-}"
    echo "[PRE-COMMIT BLOCKED] ${reason} in '${file}'" >&2
    if [ -n "$detail" ]; then
        echo "  -> ${detail}" >&2
    fi
    blocked=1
}

while IFS= read -r -d '' file; do
    [ -z "$file" ] && continue

    base_name="${file##*/}"

    # 1. Block staged file paths inside protected directories
    if printf '%s\n' "$file" | grep -Eq "$PROTECTED_PATH_REGEX"; then
        report_violation "Protected directory path staged" "$file"
    fi

    # 2. Block .env / .env.* (except .env.example)
    if [[ "$base_name" == ".env" || ( "$base_name" == .env.* && "$base_name" != ".env.example" ) ]]; then
        report_violation "Protected environment file staged" "$file"
    fi

    # 3. Block local database and session state files
    case "$base_name" in
        *.sqlite|*.db|storageState.json)
            report_violation "Protected database or session state file staged" "$file"
            ;;
    esac

    # Extract added lines (excluding +++ diff headers, stripping leading '+' and trailing CR)
    added_lines=$(git diff --cached -U0 -- "$file" | awk '/^\+\+\+ / {next} /^\+/ {line=substr($0, 2); sub(/\r$/, "", line); print line}')
    [ -z "$added_lines" ] && continue

    # 4. Block private API keys (Google AIzaSy... and OpenAI/Anthropic sk-... / sk-proj-...)
    if match=$(printf '%s\n' "$added_lines" | grep -En "$API_KEY_REGEX"); then
        report_violation "Potential private API key detected" "$file" "${match%%$'\n'*}"
    fi

    # 5. Block unredacted email addresses
    if match=$(printf '%s\n' "$added_lines" | grep -En "$EMAIL_REGEX"); then
        report_violation "Email address detected" "$file" "${match%%$'\n'*}"
    fi

    # 6. Block phone numbers (North American & international formats)
    if match=$(printf '%s\n' "$added_lines" | grep -En "$PHONE_REGEX"); then
        report_violation "Phone number detected" "$file" "${match%%$'\n'*}"
    fi

    # 7. Block content references to protected directories in code/data files
    case "$file" in
        *.md|.gitignore|.pre-commit-config.yaml|.env.example|scripts/hooks/*|scripts/setup_hooks.*)
            ;;
        *)
            if match=$(printf '%s\n' "$added_lines" | grep -En "$PROTECTED_CONTENT_REGEX"); then
                report_violation "Protected path reference (vault/, history/, or logs/) detected" "$file" "${match%%$'\n'*}"
            fi
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$blocked" -ne 0 ]; then
    echo "Commit aborted by JobApplier-Core security pre-commit hook." >&2
    exit 1
fi

exit 0
