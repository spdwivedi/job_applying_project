# JobApplier-Core Environment Configuration
# Copy this file to .env and fill in your local values. Never commit .env.

# Server & UI ports
UI_PORT=8501
API_PORT=8000

# Local directories and state paths
VAULT_PATH=./vault
TEMPLATES_PATH=./templates
HISTORY_PATH=./history
STORAGE_STATE_PATH=./vault/platform_cookies/storageState.json

# LLM Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
